{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit Debug (venv)",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py",
        "--logger.level=debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}